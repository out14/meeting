{
  "name": "meeting",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"yarn workspace server dev\" \"yarn workspace client dev\"",
    "db:init": "yarn workspace server db:init",
    "test": "yarn workspace server test",
    "build": "yarn workspace client build",
    "lint": "yarn workspace client lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
