PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=meeting
# AWS RDS 는 true (암호화 연결)
DB_SSL=
CLIENT_ORIGIN=http://localhost:5173

# 토큰 서명 키(TOKEN_SECRET)와 관리자 계정 (관리자 비밀번호 해시는 yarn workspace server admin:hash <비밀번호> 로 생성)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
TOKEN_SECRET=
ADMIN_TOKEN_TTL_HOURS=1
USER_TOKEN_TTL_HOURS=1

# 사이트 주소 (비밀번호 재설정 메일의 링크에 쓴다. 비우면 CLIENT_ORIGIN)
APP_URL=http://localhost:5173

# 메일 발송 (비밀번호 재설정). SMTP_HOST 를 비우면 메일을 보내지 않고 서버 로그에 내용을 남긴다 (개발용)
# 예) Gmail: smtp.gmail.com / 587 / 지메일 주소 / 앱 비밀번호(2단계 인증 후 발급)
#     네이버: smtp.naver.com / 465 / 네이버 아이디 / 비밀번호 (메일 설정에서 SMTP 사용 켜기)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="요정 정모 <no-reply@example.com>"

# 서버가 자동으로 정하는 마감 시각의 기준 시간대 (기본 한국 +09:00)
APP_TZ_OFFSET=+09:00

# 프록시(Nginx, 클라우드 로드밸런서 등) 뒤에서 실행하면 프록시 단계 수 (보통 1). 로그인 시도 제한이 실제 사용자 IP 로 동작한다
TRUST_PROXY=
